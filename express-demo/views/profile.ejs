<% const profileState={ user: user }; %>

    <%- rnx.state(profileState, 'user' ) %>

        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <i class="bi bi-person-circle display-1 text-primary"></i>
                        </div>
                        <h3 class="h5 fw-bold" data-bind="user.name"></h3>
                        <p class="text-muted" data-bind="user.role"></p>
                        <p class="small">
                            <i class="bi bi-envelope-fill"></i> <span data-bind="user.email"></span>
                        </p>
                        <p class="small">
                            <i class="bi bi-geo-alt-fill"></i> <span data-bind="user.location"></span>
                        </p>

                        <div class="d-grid gap-2 mt-3">
                            <%- rnx.component('Button', { variant: 'primary' , label: 'Edit Profile' , class: 'w-100' ,
                                onclick: 'window.rnx.toast.info("Edit profile clicked")' }) %>
                                <%- rnx.component('Button', { variant: 'outline-secondary' , label: 'Settings' ,
                                    class: 'w-100' , onclick: 'window.rnx.toast.info("Settings clicked")' }) %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="card">
                    <div class="card-body">
                        <h3 class="h5 fw-bold mb-3">About</h3>
                        <p data-bind="user.bio"></p>
                        <p class="small text-muted">
                            <i class="bi bi-calendar-fill"></i> Joined: <span data-bind="user.joined"></span>
                        </p>
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-body">
                        <h3 class="h5 fw-bold mb-3">Activity</h3>
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                            <div>
                                <strong>Projects Completed</strong>
                                <p class="mb-0 text-muted small">This month</p>
                            </div>
                            <span class="badge bg-success fs-5">12</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                            <div>
                                <strong>Tasks Completed</strong>
                                <p class="mb-0 text-muted small">This week</p>
                            </div>
                            <span class="badge bg-primary fs-5">48</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>Code Reviews</strong>
                                <p class="mb-0 text-muted small">Today</p>
                            </div>
                            <span class="badge bg-warning fs-5">5</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            console.log('User profile loaded:', window.user);
        </script>