<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof title !=='undefined' ? title : 'rnxJS + Express Demo' %>
    </title>

    <%- rnx.scripts(true, 'bootstrap' ) %>

        <style>
            body {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                min-height: 100vh;
                padding: 2rem 0;
            }

            .glass {
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(10px);
                border-radius: 16px;
                padding: 2rem;
                box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
            }
        </style>
</head>

<body>
    <div class="container">
        <!-- Navigation -->
        <nav class="glass mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h4 mb-0 fw-bold">
                    <i class="bi bi-lightning-charge-fill text-primary"></i> rnxJS + Express
                </h1>
                <div class="d-flex gap-2">
                    <a href="/" class="btn btn-outline-primary">Home</a>
                    <a href="/profile" class="btn btn-outline-primary">Profile</a>
                    <a href="/components" class="btn btn-outline-primary">Components</a>
                </div>
            </div>
        </nav>

        <!-- Content -->
        <div class="glass">
            <%- body %>
        </div>
    </div>

    <%- rnx.plugin('toast', { position: 'top-right' }) %>
</body>

</html>